{
  "id": "./",
  "name": "RBH · Reserve Bank of Horology",
  "short_name": "RBH",
  "description": "A private, offline-first vault for your watch collection. Photos, specs, invoices, straps, service history and a wishlist, kept only on your own device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f2f3f7",
  "theme_color": "#f2f3f7",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "lifestyle",
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add a watch",
      "short_name": "Add watch",
      "description": "Add a new watch to your collection",
      "url": "./?action=add",
      "icons": [
        {
          "src": "icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Wishlist",
      "short_name": "Wishlist",
      "description": "Watches you plan to buy",
      "url": "./?action=wishlist",
      "icons": [
        {
          "src": "icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Straps",
      "short_name": "Straps",
      "description": "Your strap collection",
      "url": "./?action=straps",
      "icons": [
        {
          "src": "icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "screenshot-01-home-mobile.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Your collection at a glance"
    },
    {
      "src": "screenshot-02-detail-mobile.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Every detail of a watch"
    },
    {
      "src": "screenshot-03-dark-pastel-mobile.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Dark mode with pastel colours"
    },
    {
      "src": "screenshot-07-home-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "RBH on a laptop or desktop"
    }
  ]
}